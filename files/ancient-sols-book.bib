@book{BourniBurns2026,
  author = {Bourni, Theodora and Burns, Nathan},
  title = {Ancient Solutions to free boundary curve shortening flow},
  publisher = {Associa{\c c}{\~a}o Instituto Nacional de Matem{\'a}tica Pura e Aplicada},
  year = {2026},
  abstract = {The study of geometric evolution equations has become a central theme in modern differential geometry and geometric analysis. Among these, cur- vature driven flows provide a powerful framework for understanding the ge- ometry and topology of submanifolds through their deformation over time. A particularly fundamental example is the curve shortening flow, the gradi- ent flow of length for planar curves, in which a family of immersions evolves in the direction of its curvature vector. Despite its simple formulation, this flow exhibits rich behavior and serves as a model for the highly important higher-dimensional mean curvature flow, which has numerous applications.},
}